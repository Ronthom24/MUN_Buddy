PORT=3000
NODE_ENV=development

# Supabase project (Postgres, Auth, Storage). SUPABASE_DB_URL should use the
# Session Pooler host (aws-0-<region>.pooler.supabase.com:5432), not the
# Direct connection string -- the Direct host is IPv6-only and most
# networks/hosts don't have an outbound IPv6 route. Percent-encode special
# characters in the password (e.g. @ -> %40).
SUPABASE_DB_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Signs the admin-view bridge token (platform admin "view as organizer" --
# see platformAdminViewService.js). Not used for organizer/delegate/platform
# admin login itself -- those are Supabase Auth JWTs now.
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Used to build links inside emails (verification, password reset), and as
# the default allowed CORS origin if CORS_ORIGINS isn't set.
FRONTEND_URL=http://localhost:3000

# Optional: comma-separated list of allowed CORS origins. Overrides
# FRONTEND_URL for CORS purposes -- set this when the frontend is served
# from a different origin than FRONTEND_URL, or from multiple origins.
# CORS_ORIGINS=https://app.munbuddy.com,https://admin.munbuddy.com

# Set to false to temporarily disable the email-verification login gate
# (e.g. before real SMTP delivery to a verified domain is working). Default
# is true (verification required) when unset.
REQUIRE_EMAIL_VERIFICATION=true

# Consumed once by `npm run seed:production` (backend/scripts/seedPlatformAdmin.js)
# to create/update the platform administrator account. Change the password
# immediately after first login.
SUPER_ADMIN_NAME=Platform Administrator
SUPER_ADMIN_EMAIL=admin@munbuddy.app
SUPER_ADMIN_PASSWORD=change_this_password

# File uploads default to local disk (not durable across redeploys on most
# hosts). Set STORAGE_DRIVER=s3 and fill these in to use S3 or any
# S3-compatible bucket (Cloudflare R2, Backblaze B2, DigitalOcean Spaces,
# Supabase Storage, ...) instead. See storageService.js.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only needed for non-AWS S3-compatible providers (R2, MinIO, Supabase, etc.)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Optional: public CDN/base URL to serve files from instead of the bucket's
# default S3 endpoint URL.
S3_PUBLIC_URL_BASE=

# Supabase Storage specifically: S3_ENDPOINT is
# https://<project-ref>.storage.supabase.co/storage/v1/s3 (note the
# storage.supabase.co subdomain -- NOT the plain <project-ref>.supabase.co
# used for SUPABASE_URL above, confirmed via the S3 Configuration page in
# the dashboard), S3_FORCE_PATH_STYLE must be true, and
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY come from Storage settings > S3
# Access Keys in the dashboard (not the anon/service_role keys used
# elsewhere in this file -- those don't work for the S3 API). For a public
# bucket, S3_PUBLIC_URL_BASE stays on the plain project domain:
# https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>.

# Optional: email broadcasts run in log-only mode until these are set (see emailService.js)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MUN Buddy <no-reply@munbuddy.local>
