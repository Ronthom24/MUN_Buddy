PORT=3000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=mun_buddy
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Optional: email broadcasts run in log-only mode until these are set (see emailService.js)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MUN Buddy <no-reply@munbuddy.local>
